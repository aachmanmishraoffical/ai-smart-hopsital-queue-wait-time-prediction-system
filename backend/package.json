{
  "name": "ai-smart-hospital-backend",
  "version": "1.0.0",
  "description": "Backend for AI Smart Hospital Queue & Appointment System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "sync:directory": "node scripts/importHospitalDirectory.js",
    "export:wait-observations": "node scripts/exportApprovedWaitObservations.js",
    "ml:test": "python -m unittest discover -s ml -p test_*.py",
    "ml:train": "python ml/waiting_time_model.py",
    "ml:service": "python ml/app.py"
  },
